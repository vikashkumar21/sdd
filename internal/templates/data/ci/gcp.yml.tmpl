# Google Cloud Build Workflow generated by sdd
steps:
  # Phase 1: Install SDD Static Binary
  - id: 'install-sdd'
    name: 'curlimages/curl'
    entrypoint: 'sh'
    args:
      - '-c'
      - |
        curl -fsSL https://raw.githubusercontent.com/vikashkumar21/sdd/main/scripts/install.sh | sh -s -- --dir /workspace/.sdd-bin
    volumes:
      - name: 'sdd-bin'
        path: '/workspace/.sdd-bin'

  # Phase 2: SDD Governance Guard
  - id: 'sdd-check'
    name: 'ubuntu:latest'
    entrypoint: 'sh'
    args:
      - '-c'
      - |
        /workspace/.sdd-bin/sdd check --strict
    volumes:
      - name: 'sdd-bin'
        path: '/workspace/.sdd-bin'

  # Phase 3: Code Quality & Lint
  - id: 'lint'
{{if .IsGo}}    name: 'golang:1.27'
{{else if .IsPython}}    name: 'python:3.12'
{{else if .IsTypeScript}}    name: 'node:20'
{{else if .IsJava}}    name: 'maven:3.9-eclipse-temurin-21'
{{else}}    name: 'ubuntu:latest'
{{end}}    entrypoint: 'sh'
    args:
      - '-c'
      - |
{{if .IsPython}}        pip install --upgrade pip && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
{{else if .IsTypeScript}}        if [ -f package-lock.json ]; then npm ci; else npm install; fi
{{end}}        {{.LintCmd}}

  # Phase 4: Compile and Build
  - id: 'compile-build'
{{if .IsGo}}    name: 'golang:1.27'
{{else if .IsPython}}    name: 'python:3.12'
{{else if .IsTypeScript}}    name: 'node:20'
{{else if .IsJava}}    name: 'maven:3.9-eclipse-temurin-21'
{{else}}    name: 'ubuntu:latest'
{{end}}    entrypoint: 'sh'
    args:
      - '-c'
      - |
        {{.BuildCmd}}

  # Phase 5: Automated Testing & Determinism
  - id: 'test'
{{if .IsGo}}    name: 'golang:1.27'
{{else if .IsPython}}    name: 'python:3.12'
{{else if .IsTypeScript}}    name: 'node:20'
{{else if .IsJava}}    name: 'maven:3.9-eclipse-temurin-21'
{{else}}    name: 'ubuntu:latest'
{{end}}    entrypoint: 'sh'
    args:
      - '-c'
      - |
        {{.TestCmd}}
        {{.DeterminismCmd}}

  # --- Optional Release Stages (Triggered on main branch only) ---
  # - id: 'publish-binary'
  #   name: 'google/cloud-sdk:latest'
  #   entrypoint: 'sh'
  #   args:
  #     - '-c'
  #     - |
  #       # TODO(human): Set your GCS bucket URL
  #       # gcloud storage cp -r ./dist/ gs://YOUR_BINARY_BUCKET/$COMMIT_SHA/
  #       echo "Publishing binaries to YOUR_GCS_BUCKET_URL..."

  # - id: 'publish-docker'
  #   name: 'gcr.io/cloud-builders/docker'
  #   args:
  #     - 'build'
  #     - '-t'
  #     # TODO(human): Set your Artifact Registry URL (e.g. us-docker.pkg.dev/$PROJECT_ID/REPO/IMAGE)
  #     - 'us-docker.pkg.dev/$PROJECT_ID/app-repo/app:$COMMIT_SHA'
  #     - '.'

options:
  logging: CLOUD_LOGGING_ONLY
