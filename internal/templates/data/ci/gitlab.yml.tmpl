# GitLab CI Workflow generated by sdd
stages:
  - governance
  - verify
  - publish

default:
{{if .IsGo}}  image: golang:1.27
{{else if .IsPython}}  image: python:3.12
{{else if .IsTypeScript}}  image: node:20
{{else if .IsJava}}  image: maven:3.9-eclipse-temurin-21
{{else}}  image: ubuntu:latest
{{end}}
sdd-governance:
  stage: governance
  before_script:
    - which curl || (apt-get update && apt-get install -y curl git)
    - curl -fsSL https://raw.githubusercontent.com/vikashkumar21/sdd/main/scripts/install.sh | sh
    - export PATH="$HOME/.local/bin:$PATH"
  script:
    - sdd check --strict

project-verify:
  stage: verify
  before_script:
{{if .IsPython}}    - pip install --upgrade pip && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
{{else if .IsTypeScript}}    - if [ -f package-lock.json ]; then npm ci; else npm install; fi
{{else}}    - true
{{end}}  script:
    - echo "Running code quality and lint..."
    - {{.LintCmd}}
    - echo "Compiling and building project..."
    - {{.BuildCmd}}
    - echo "Running automated test suite..."
    - {{.TestCmd}}
    - echo "Running determinism flake guard..."
    - {{.DeterminismCmd}}

