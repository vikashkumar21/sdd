# AWS CodeBuild Specification generated by sdd
version: 0.2

phases:
  install:
{{if .IsGo}}    runtime-versions:
      golang: 1.27
{{else if .IsPython}}    runtime-versions:
      python: 3.12
{{else if .IsTypeScript}}    runtime-versions:
      nodejs: 20
{{else if .IsJava}}    runtime-versions:
      java: corretto21
{{end}}    commands:
      - echo "Installing SDD static binary..."
      - curl -fsSL https://raw.githubusercontent.com/vikashkumar21/sdd/main/scripts/install.sh | sh
      - export PATH="$HOME/.local/bin:$PATH"
{{if .IsPython}}      - pip install --upgrade pip
      - if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
{{else if .IsTypeScript}}      - if [ -f package-lock.json ]; then npm ci; else npm install; fi
{{end}}
  pre_build:
    commands:
      - echo "Phase 2: SDD Governance Guard..."
      - sdd check --strict
      - echo "Phase 3: Code Quality and Linting..."
      - {{.LintCmd}}
      - echo "Phase 4: Compile and Build Verification..."
      - {{.BuildCmd}}

  build:
    commands:
      - echo "Phase 5: Automated Testing..."
      - {{.TestCmd}}
      - echo "Phase 5: Determinism Flake Guard..."
      - {{.DeterminismCmd}}

