# Bitbucket Pipelines Workflow generated by sdd
{{if .IsGo}}image: golang:1.27
{{else if .IsPython}}image: python:3.12
{{else if .IsTypeScript}}image: node:20
{{else if .IsJava}}image: maven:3.9-eclipse-temurin-21
{{else}}image: atlassian/default-image:4
{{end}}
pipelines:
  default:
    - step:
        name: SDD Governance & Verification
        caches:
{{if .IsGo}}          - go
{{else if .IsPython}}          - pip
{{else if .IsTypeScript}}          - node
{{else if .IsJava}}          - maven
{{end}}        script:
          - which curl || (apt-get update && apt-get install -y curl git)
          - curl -fsSL https://raw.githubusercontent.com/vikashkumar21/sdd/main/scripts/install.sh | sh
          - export PATH="$HOME/.local/bin:$PATH"
          - echo "Running SDD governance check..."
          - sdd check --strict
{{if .IsPython}}          - pip install --upgrade pip && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
{{else if .IsTypeScript}}          - if [ -f package-lock.json ]; then npm ci; else npm install; fi
{{end}}          - echo "Running code quality and lint..."
          - {{.LintCmd}}
          - echo "Compiling and building..."
          - {{.BuildCmd}}
          - echo "Running test suite..."
          - {{.TestCmd}}
          - echo "Running determinism flake guard..."
          - {{.DeterminismCmd}}

  branches:
    main:
      - step:
          name: SDD Governance & Verification
          caches:
{{if .IsGo}}            - go
{{else if .IsPython}}            - pip
{{else if .IsTypeScript}}            - node
{{else if .IsJava}}            - maven
{{end}}          script:
            - which curl || (apt-get update && apt-get install -y curl git)
            - curl -fsSL https://raw.githubusercontent.com/vikashkumar21/sdd/main/scripts/install.sh | sh
            - export PATH="$HOME/.local/bin:$PATH"
            - sdd check --strict
{{if .IsPython}}            - pip install --upgrade pip && if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
{{else if .IsTypeScript}}            - if [ -f package-lock.json ]; then npm ci; else npm install; fi
{{end}}            - {{.LintCmd}}
            - {{.BuildCmd}}
            - {{.TestCmd}}
            - {{.DeterminismCmd}}
      # Optional: Uncomment to publish binaries and Docker image on main
      # - step:
