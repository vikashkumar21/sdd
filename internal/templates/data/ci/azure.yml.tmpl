# Azure DevOps Pipeline generated by sdd
trigger:
  branches:
    include:
      - main

pr:
  branches:
    include:
      - main

pool:
  vmImage: 'ubuntu-latest'

steps:
  - checkout: self
    fetchDepth: 0

{{if .IsGo}}  - task: GoTool@0
    inputs:
      version: '1.27'
    displayName: 'Setup Go Toolchain'
{{else if .IsPython}}  - task: UsePythonVersion@0
    inputs:
      versionSpec: '3.12'
    displayName: 'Setup Python Runtime'

  - script: |
      python -m pip install --upgrade pip
      if [ -f requirements.txt ]; then pip install -r requirements.txt; fi
    displayName: 'Install Python Dependencies'
{{else if .IsTypeScript}}  - task: NodeTool@0
    inputs:
      versionSpec: '20.x'
    displayName: 'Setup Node.js Runtime'

  - script: |
      if [ -f package-lock.json ]; then npm ci; else npm install; fi
    displayName: 'Install Node Dependencies'
{{else if .IsJava}}  - task: JavaToolInstaller@0
    inputs:
      versionSpec: '21'
      jdkArchitectureOption: 'x64'
      jdkSourceOption: 'PreInstalled'
    displayName: 'Setup Java JDK'
{{end}}
  - script: |
      curl -fsSL https://raw.githubusercontent.com/vikashkumar21/sdd/main/scripts/install.sh | sh
      echo "##vso[task.prependpath]$HOME/.local/bin"
    displayName: 'Install SDD Static Binary'

  - script: |
      sdd check --strict
    displayName: 'SDD Governance Guard'

  - script: |
      {{.LintCmd}}
    displayName: 'Code Quality & Lint'

  - script: |
      {{.BuildCmd}}
    displayName: 'Compile and Build'

  - script: |
      {{.TestCmd}}
    displayName: 'Run Test Suite'

  - script: |
      {{.DeterminismCmd}}
    displayName: 'Determinism Flake Guard'

